  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>1. El Umbral Digital (Naturaleza y Alcance de la Simulaci\xF3n)</b>\nSenda.VR
    funciona como un espacio de transici\xF3n, entrenamiento cognitivo y preparaci\xF3n
    inmersiva previo al contacto con la naturaleza. Los entornos virtuales disponibles
    \u2014como la representaci\xF3n del Parque Natural Aguas de Ram\xF3n\u2014 son
    gemelos digitales desarrollados mediante t\xE9cnicas de reconstrucci\xF3n espacial
    con el objetivo de reducir la incertidumbre log\xEDstica, familiarizar al visitante
    con la se\xF1al\xE9tica y educar sobre la geograf\xEDa local.\n\nSin embargo,
    el usuario comprende y acepta que esta experiencia es una referencia educativa
    y no un sistema de navegaci\xF3n en tiempo real. El entorno f\xEDsico de la precordillera
    es din\xE1mico; factores como erosiones recientes en el terreno, desprendimientos
    de rocas, crecidas de esteros, desniveles exactos y condiciones meteorol\xF3gicas
    cambian constantemente y pueden diferir de lo representado en la simulaci\xF3n."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
